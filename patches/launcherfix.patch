 {
+#ifdef Q_OS_WINDOWS
     return KfxVersion::getVersionString(
         QCoreApplication::applicationDirPath() + "/keeperfx.exe"
     );
+#else
+    QFile versionFile(QCoreApplication::applicationDirPath() + "/keeperfx-version.txt");
+    if (versionFile.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        return QString::fromUtf8(versionFile.readAll()).trimmed();
+    }
+    return QString();
+#endif
 }
 
